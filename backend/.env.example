# Database Configuration - Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Security
DEFAULT_PSK=aligo-shared-secret-2024-v1
AGENT_PSK=aligo-shared-secret-2024-v1

# AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Logging
SQL_ECHO=False
LOG_LEVEL=INFO

# Features
ENABLE_AI=True
ENABLE_ENCRYPTION=True
